=== library_queries.sql statement 12 ===
-- 12. 대출 이력 없는 도서: NOT EXISTS 서브쿼리
-- 바깥 책 b마다 대출 l이 존재하는지 확인한다. 한 건이라도 있으면 제외한다. 결과는 도서 30번 1행.
SELECT b.book_id, b.title
FROM books AS b
WHERE NOT EXISTS (
    SELECT 1
    FROM loans AS l
    WHERE l.book_id = b.book_id
)
ORDER BY b.book_id;
book_id | title
--------+----------
30      | 돈의 속성
rows: 1
