=== bonus/join_sub.sql statement 1 ===
-- 유저아이디에 대출이 존재하지않는 경우를 join으로 조회하는 쿼리
select u.user_id, u.name
from users u
left join loans l on u.user_id = l.user_id
where l.loan_id is null;
user_id | name
--------+-------
23      | 남준혁
24      | 전수아
29      | 양승민
30      | 노은채
rows: 4

=== bonus/join_sub.sql statement 2 ===
-- 상관쿼리로 유저아이디에 대출이 존재하지않는 경우를 조회하는 쿼리
select u.user_id, u.name
from users u
where not EXISTS (
    select 1
    from loans l
    where l.user_id = u.user_id
);
user_id | name
--------+-------
23      | 남준혁
24      | 전수아
29      | 양승민
30      | 노은채
rows: 4
